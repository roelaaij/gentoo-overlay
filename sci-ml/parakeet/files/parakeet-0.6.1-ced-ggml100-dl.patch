diff --git a/third_party/ced.cpp/CMakeLists.txt b/third_party/ced.cpp/CMakeLists.txt
index 5c82aad..9db08f6 100644
--- a/third_party/ced.cpp/CMakeLists.txt
+++ b/third_party/ced.cpp/CMakeLists.txt
@@ -21,6 +21,7 @@ if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
 endif()
 
 option(CED_EXTERNAL_DR_WAV "Use the embedding project's dr_wav implementation" OFF)
+option(CED_USE_SYSTEM_GGML "Use system-provided libggml instead of the vendored submodule" OFF)
 
 if(CED_TOP_LEVEL)
   set(GGML_CUDA   ${CED_GGML_CUDA}   CACHE BOOL "" FORCE)
@@ -36,6 +37,15 @@ if(CED_TOP_LEVEL)
     set(GGML_LLAMAFILE ON CACHE BOOL "ggml: use LLAMAFILE (tinyBLAS SGEMM)" FORCE)
   endif()
 endif()
+# Only when embedded in a host that has not already provided a `ggml` target:
+# an alias cannot be created when the name is taken, which is exactly the case
+# when parakeet.cpp (or another host) resolved ggml itself.
+if(CED_USE_SYSTEM_GGML AND NOT TARGET ggml)
+  message(STATUS "ced.cpp: using system-provided libggml, skipping ggml submodule build")
+  find_package(ggml REQUIRED)
+  add_library(ggml ALIAS ggml::ggml)
+endif()
+
 if(NOT TARGET ggml)
   add_subdirectory(third_party/ggml)
 endif()
