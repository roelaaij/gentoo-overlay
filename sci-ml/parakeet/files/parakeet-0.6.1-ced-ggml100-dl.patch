+// Backend-agnostic helpers used in place of the CPU-backend-specific entry
+// points (ggml_backend_cpu_init / ggml_backend_cpu_set_n_threads). Those live
+// in the ggml-cpu translation unit, which is a dlopen'd MODULE in a
+// GGML_BACKEND_DL build and therefore not linkable from here. Same pattern as
+// voice-detect.cpp's backend.cpp.
+static ggml_backend_t backend_cpu_init() {
+    return ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+}
+
+static void backend_set_n_threads(ggml_backend_t b, int n_threads) {
+    if (!b) return;
+    ggml_backend_dev_t dev = ggml_backend_get_device(b);
+    if (!dev) return;
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    if (!reg) return;
+    auto set_fn = (ggml_backend_set_n_threads_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+    if (set_fn) set_fn(b, n_threads);
+}
