+From 8f4e21c9a0b3d4e5f6a7b8c9d0e1f2a3b4c5d6e7 Mon Sep 17 00:00:00 2001
+From: Roel Aaij <roel.aaij@nikhef.nl>
+Date: Mon, 16 Nov 2026 13:00:00 +0100
+Subject: [PATCH] ggml-cpu: expose ggml_get_type_traits_cpu via get_proc_address
+
+Consumers that need the CPU type traits (vec_dot / from_float /
+vec_dot_type) outside the ggml-cpu translation unit cannot link them in a
+GGML_BACKEND_DL build: there the CPU backend is a dlopen'd MODULE, so
+ggml_get_type_traits_cpu is not available at link time. The registry's
+get_proc_address mechanism is the intended way to reach such symbols.
+
+Add "ggml_backend_cpu_get_type_traits_cpu" to the CPU backend's
+get_proc_address so a consumer can do:
+
+    reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(b));
+    auto traits_fn = (ggml_get_type_traits_cpu_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_get_type_traits_cpu");
+
+No behaviour change for existing consumers.
+---
+ src/ggml-cpu/ggml-cpu.cpp | 5 +++++
+ 1 file changed, 5 insertions(+)
+
+diff --git a/src/ggml-cpu/ggml-cpu.cpp b/src/ggml-cpu/ggml-cpu.cpp
+index 1111111..2222222 100644
+--- a/src/ggml-cpu/ggml-cpu.cpp
++++ b/src/ggml-cpu/ggml-cpu.cpp
+@@ -675,6 +675,11 @@ static void * ggml_backend_cpu_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+     if (strcmp(name, "ggml_backend_cpu_set_use_ref") == 0) {
+         return (void *)ggml_backend_cpu_set_use_ref;
+     }
++    if (strcmp(name, "ggml_backend_cpu_get_type_traits_cpu") == 0) {
++        // Exposed for consumers that need the CPU type traits but link
++        // against a GGML_BACKEND_DL build, where this TU is a MODULE.
++        return (void *)ggml_get_type_traits_cpu;
++    }
+
+     // threadpool - TODO:  move to ggml-base
+     if (strcmp(name, "ggml_threadpool_new") == 0) {
+--
+2.47.0
